    <formulas>
        <description>Extracts the EventDate value from the AI-suggested life event JSON response text.</description>
        <name>EventDateFormula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!SuggestedLifeEvent},&apos;&quot;EventDate&quot;: &quot;&apos;),
  MID({!SuggestedLifeEvent},
    FIND(&apos;&quot;EventDate&quot;: &quot;&apos;,{!SuggestedLifeEvent})+14,
    FIND(&apos;&quot;&apos;,{!SuggestedLifeEvent},
      FIND(&apos;&quot;EventDate&quot;: &quot;&apos;,{!SuggestedLifeEvent})+14)
    -FIND(&apos;&quot;EventDate&quot;: &quot;&apos;,{!SuggestedLifeEvent})-14),
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Extracts the EventDescription value from the AI-suggested life event JSON response text.</description>
        <name>EventDescriptionFormula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!SuggestedLifeEvent},&apos;&quot;EventDescription&quot;: &quot;&apos;),
  MID({!SuggestedLifeEvent},
    FIND(&apos;&quot;EventDescription&quot;: &quot;&apos;,{!SuggestedLifeEvent})+21,
    FIND(&apos;&quot;&apos;,{!SuggestedLifeEvent},
      FIND(&apos;&quot;EventDescription&quot;: &quot;&apos;,{!SuggestedLifeEvent})+21)
    -FIND(&apos;&quot;EventDescription&quot;: &quot;&apos;,{!SuggestedLifeEvent})-21),
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Extracts the EventName value from the AI-suggested life event JSON response text.</description>
        <name>EventNameFormula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!SuggestedLifeEvent},&apos;&quot;EventName&quot;: &quot;&apos;),
  MID({!SuggestedLifeEvent},
    FIND(&apos;&quot;EventName&quot;: &quot;&apos;,{!SuggestedLifeEvent})+14,
    FIND(&apos;&quot;&apos;,{!SuggestedLifeEvent},
      FIND(&apos;&quot;EventName&quot;: &quot;&apos;,{!SuggestedLifeEvent})+14)
    -FIND(&apos;&quot;EventName&quot;: &quot;&apos;,{!SuggestedLifeEvent})-14),
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Extracts the EventType value from the AI-suggested life event JSON response text.</description>
        <name>EventTypeFormula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!SuggestedLifeEvent},&apos;&quot;EventType&quot;: &quot;&apos;),
  MID({!SuggestedLifeEvent},
    FIND(&apos;&quot;EventType&quot;: &quot;&apos;,{!SuggestedLifeEvent})+14,
    FIND(&apos;&quot;&apos;,{!SuggestedLifeEvent},
      FIND(&apos;&quot;EventType&quot;: &quot;&apos;,{!SuggestedLifeEvent})+14)
    -FIND(&apos;&quot;EventType&quot;: &quot;&apos;,{!SuggestedLifeEvent})-14),
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Converts the text value from EventDateText to a date value.</description>
        <name>EvntDateStringToDateFormula</name>
