    <decisions>
        <description>Determines whether the input account is a Person Account or a Household Account.</description>
        <name>Is_Household</name>
        <label>Is Household</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Household_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Input.objectToSummarize.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Primary_Household_Member</targetReference>
            </connector>
            <label>Is Household Account</label>
        </rules>
        <rules>
            <name>Is_Person_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Input.objectToSummarize.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Primary_Member_Account_ID_for_Person_Account</targetReference>
            </connector>
            <label>Is Person Account</label>
        </rules>
    </decisions>
