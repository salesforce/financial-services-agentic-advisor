    <formulas>
        <description>Stores the extracted part of a flow error message that’s shown to the user.</description>
        <name>ExtractErrorMessageFormula</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    CONTAINS({!$Flow.FaultMessage}, &quot;This error occurred&quot;),
    CONTAINS({!$Flow.FaultMessage}, &quot;. You can look up ExceptionCode&quot;),
    FIND(&quot;This error occurred&quot;, {!$Flow.FaultMessage}) &lt; FIND(&quot;. You can look up ExceptionCode&quot;, {!$Flow.FaultMessage})
  ),
  TRIM(
    MID(
      {!$Flow.FaultMessage},
      FIND(&quot;:&quot;, {!$Flow.FaultMessage}, FIND(&quot;This error occurred&quot;, {!$Flow.FaultMessage})) + 2,
      FIND(&quot;. You can look up ExceptionCode&quot;, {!$Flow.FaultMessage}) -
      (FIND(&quot;:&quot;, {!$Flow.FaultMessage}, FIND(&quot;This error occurred&quot;, {!$Flow.FaultMessage})) + 2)
    )
  ),
  TRIM({!$Flow.FaultMessage})
)</expression>
    </formulas>
    <formulas>
        <description>Concatenates the FirstName and LastName of the Contact in Contact Contact Relationship from GetContactContactRelationship to create the account name for the related contact.</description>
        <name>FullNameFormula</name>
        <dataType>String</dataType>
        <expression>TRIM(IF(ISBLANK({!GetContactContactRelationship.FinServ__RelatedContact__r.FirstName}), &quot;&quot;, {!GetContactContactRelationship.FinServ__RelatedContact__r.FirstName} &amp; &quot; &quot;) &amp; IF(ISBLANK({!GetContactContactRelationship.FinServ__RelatedContact__r.LastName}), &quot;&quot;, {!GetContactContactRelationship.FinServ__RelatedContact__r.LastName}))</expression>
    </formulas>
