    <formulas>
        <description>Returns the name of the Related Account in the Account Account Relationship from GetAccountAccountRelationship record variable.</description>
        <name>RelatedGroupNameFormula</name>
        <dataType>String</dataType>
        <expression>TRIM(IF(ISBLANK({!GetAccountAccountRelationship.FinServ__RelatedAccount__r.Name}), &quot;&quot;, {!GetAccountAccountRelationship.FinServ__RelatedAccount__r.Name}))</expression>
    </formulas>
    <formulas>
        <description>Returns the extracted part of a flow error message that is shown to the user.</description>
        <name>ExtractErrorMessageFormula</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    CONTAINS({!$Flow.FaultMessage}, &quot;This error occurred&quot;),
    CONTAINS({!$Flow.FaultMessage}, &quot;. You can look up ExceptionCode&quot;),
    FIND(&quot;This error occurred&quot;, {!$Flow.FaultMessage}) &lt; FIND(&quot;. You can look up ExceptionCode&quot;, {!$Flow.FaultMessage})
  ),
  TRIM(
    MID(
      {!$Flow.FaultMessage},
      FIND(&quot;:&quot;, {!$Flow.FaultMessage}, FIND(&quot;This error occurred&quot;, {!$Flow.FaultMessage})) + 2,
      FIND(&quot;. You can look up ExceptionCode&quot;, {!$Flow.FaultMessage}) -
      (FIND(&quot;:&quot;, {!$Flow.FaultMessage}, FIND(&quot;This error occurred&quot;, {!$Flow.FaultMessage})) + 2)
    )
  ),
  TRIM({!$Flow.FaultMessage})
)</expression>
    </formulas>
