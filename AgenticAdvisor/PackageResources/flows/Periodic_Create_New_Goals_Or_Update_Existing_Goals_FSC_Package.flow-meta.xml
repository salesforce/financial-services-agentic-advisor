<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Invokes the AI prompt that, in a single pass, reviews the post-meeting notes against the existing financial goals related to this record and returns both new goals to create and field-level edits to existing goals. One prompt (rather than separate create and edit prompts) lets the model deduplicate across the two categories: a goal already covered by an existing goal is returned as an edit, never as a duplicate new goal.</description>
        <name>Call_GoalReviewPrompt</name>
        <label>Call Goal Review Prompt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>meetingcenter_wealth__PeriodicGenerateGoalFlowPrompt</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Screen_ReviewGoals</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:MeetingPlaybookStage</name>
            <value>
                <elementReference>Get_Meeting_PlaybookStage</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:MeetingNotes</name>
            <value>
                <elementReference>Get_MeetingFollowupText.Text</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:ExistingGoalsContext</name>
            <value>
                <elementReference>existingGoalsContext</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>meetingcenter_wealth__PeriodicGenerateGoalFlowPrompt</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>reviewJson</assignToReference>
            <name>promptResponse</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
