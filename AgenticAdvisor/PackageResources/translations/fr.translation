            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>Package FSC Concierge de réunion : Créer un événement de vie de la personne</label>
            <screens>
                <fields>
                    <fieldText>Nom de l’événement</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Type d'événement</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Date de l'événement</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Description de l'événement</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Un problème est survenu lors de la création de l'enregistrement Événement de vie de la personne. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;L'événement de vie de la personne {!EventNameText} a été créé.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
