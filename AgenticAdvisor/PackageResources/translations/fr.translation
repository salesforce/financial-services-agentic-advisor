            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Package FSC périodique Concierge de réunion : Créer des objectifs ou mettre à jour les objectifs existants</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Objectifs existants mis à jour avec succès !&lt;/p&gt;&lt;p&gt;Vos modifications ont été enregistrées. &lt;/p&gt;&lt;p&gt;Nous allons ensuite analyser vos notes de réunion pour suggérer de nouveaux objectifs financiers.&lt;/p&gt;&lt;p&gt;Pour continuer, cliquez sur « Analyser les notes de réunion ». Cette opération peut prendre jusqu'à 30 secondes.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Un problème est survenu lors de l'exécution du flux &lt;/p&gt;&lt;p&gt;Détails : {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Tous les objectifs ont été révisés et enregistrés avec succès.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Mettre à jour l'objectif existant&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Nom de l'objectif</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Montant cible</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Date cible</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Statut</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Description</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Nouvel objectif suggéré&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Nom de l'objectif</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Type d'objectif</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Statut de l’objectif</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Montant cible</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Date cible</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Description</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Ignorer cet objectif</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>Package FSC périodique Concierge de réunion : Créer des objectifs ou mettre à jour les objectifs existants</label>
    </flowDefinitions>
