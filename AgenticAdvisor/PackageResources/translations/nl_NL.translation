            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>Vergaderingsconciërge: FSC-pakket voor levensgebeurtenissen van personen</label>
            <screens>
                <fields>
                    <fieldText>Naam van event</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Eventtype</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Datum van event</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Beschrijving van event</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Er is iets verkeerd gegaan bij het maken van de record voor de levensgebeurtenis van een persoon. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;De levensgebeurtenis {!EventNameText} van de persoon is gemaakt.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
