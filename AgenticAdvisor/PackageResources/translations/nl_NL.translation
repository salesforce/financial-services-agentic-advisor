            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Vergaderingsconciërge: FSC-pakket voor periodiek nieuwe doelen maken of bestaande doelen bijwerken</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Bestaande doelen zijn bijgewerkt!&lt;/p&gt;&lt;p&gt;Uw wijzigingen zijn opgeslagen. &lt;/p&gt;&lt;p&gt;We gaan nu uw notulen analyseren, waaruit nieuwe financiële doelen naar voren komen.&lt;/p&gt;&lt;p&gt;Klik op 'Notulen analyseren' om door te gaan; dit kan tot 30 seconden duren.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Er is iets verkeerd gegaan bij het uitvoeren van de stroom &lt;/p&gt;&lt;p&gt;Details: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Alle doelen zijn beoordeeld en opgeslagen.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Bestaand doel bijwerken&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Doelnaam</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Doelbedrag</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Doeldatum</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Status</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Beschrijving</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Nieuw doel voorgesteld&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Doelnaam</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Doeltype</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Doelstatus</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Doelbedrag</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Doeldatum</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Beschrijving</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Dit doel overslaan</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>Vergaderingsconciërge: FSC-pakket voor periodiek nieuwe doelen maken of bestaande doelen bijwerken</label>
