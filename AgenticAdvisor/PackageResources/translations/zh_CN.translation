            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>会议礼宾：创建个人人生大事 FSC 软件包</label>
            <screens>
                <fields>
                    <fieldText>事件名称</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>事件类型</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>事件日期</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>事件描述</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;创建个人人生大事记录时出错。{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;个人人生大事 {!EventNameText} 已创建。&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
        <fullName>Create_Person_Life_Event_FSC_Package</fullName>
        <label>会议礼宾：创建个人人生大事 FSC 软件包</label>
