            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>会议礼宾：定期新建目标或更新现有目标 FSC 软件包</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ 现有目标更新成功！&lt;/p&gt;&lt;p&gt;您的更改已保存。&lt;/p&gt;&lt;p&gt;接下来，我们将分析您的会议纪要，并为您推荐新的财务目标。&lt;/p&gt;&lt;p&gt;单击“分析会议纪要”继续 — 预计耗时约 30 秒。&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;运行该流时出错&lt;/p&gt;&lt;p&gt;详细信息：{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;全部目标均已审核并成功保存。&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;更新现有目标&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>目标名称</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>目标金额</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>目标日期</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>状态</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>描述</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;建议的新目标&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>目标名称</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>目标类型</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>目标状态</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>目标金额</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>目标日期</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>描述</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>跳过该目标</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>会议礼宾：定期新建目标或更新现有目标 FSC 软件包</label>
