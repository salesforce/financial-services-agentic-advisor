            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>Meeting Concierge: Create Person Life Event FSC Package</label>
            <screens>
                <fields>
                    <fieldText>Event Name</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Event Type</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Event Date</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Event Description</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Something went wrong creating the Person Life Event record. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;The Person Life Event {!EventNameText} was created.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
