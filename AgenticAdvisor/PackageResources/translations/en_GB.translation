            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Meeting Concierge: Periodic Create New Goals Or Update Existing Goals FSC Package</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Existing Goals Updated Successfully!&lt;/p&gt;&lt;p&gt;Your changes have been saved. &lt;/p&gt;&lt;p&gt;Next, we'll analyse your meeting notes suggest new financial goals.&lt;/p&gt;&lt;p&gt;Click "Analyse Meeting Notes" to continue — this may take up to 30 seconds.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Something went wrong while running the flow &lt;/p&gt;&lt;p&gt;Details: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;All goals have been reviewed and saved successfully.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Update Existing Goal&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Goal Name</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Target Amount</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Target Date</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Status</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Description</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;New Goal Suggested&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Goal Name</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Goal Type</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Goal Status</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Target Amount</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Target Date</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Description</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Skip this goal</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
