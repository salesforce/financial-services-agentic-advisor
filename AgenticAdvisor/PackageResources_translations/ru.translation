            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>Консьерж встреч: пакет FSC для создания события из личной жизни</label>
            <screens>
                <fields>
                    <fieldText>Имя события</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Тип события</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Дата события</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Описание события</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;При создании записи события из личной жизни произошла ошибка. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Событие из личной жизни "{!EventNameText}" создано.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
