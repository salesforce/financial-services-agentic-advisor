            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Concierge für Besprechungen: FSC-Paket für die regelmäßige Erstellung neuer Ziele oder die Aktualisierung vorhandener Ziele</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Vorhandene Ziele erfolgreich aktualisiert!&lt;/p&gt;&lt;p&gt;Ihre Änderungen wurden gespeichert. &lt;/p&gt;&lt;p&gt;Als Nächstes werden Ihre Besprechungsnotizen analysiert und daraus Vorschläge für Finanzziele erstellt.&lt;/p&gt;&lt;p&gt;Klicken Sie zum Fortfahren auf "Besprechungsnotizen analysieren" – dies kann bis zu 30 Sekunden dauern.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Bei der Ausführung des Flows ist ein Fehler aufgetreten&lt;/p&gt;&lt;p&gt;Details: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Alle Ziele wurden überprüft und erfolgreich gespeichert.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Vorhandenes Ziel aktualisieren&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Zielname</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Zielbetrag</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Zieldatum</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Status</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Beschreibung</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Neues Ziel vorgeschlagen&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Zielname</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Zieltyp</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Zielstatus</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Zielbetrag</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Zieldatum</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Beschreibung</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Dieses Ziel überspringen</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>Concierge für Besprechungen: FSC-Paket für die regelmäßige Erstellung neuer Ziele oder die Aktualisierung vorhandener Ziele</label>
