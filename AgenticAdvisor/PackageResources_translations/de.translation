            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>Concierge für Besprechungen: FSC-Paket für die Erstellung von Personenlebensereignissen</label>
            <screens>
                <fields>
                    <fieldText>Ereignisnamen</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Ereignistyp</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Ereignisdatum</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Ereignisbeschreibung</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Beim Erstellen des Datensatzes für das Personenlebensereignis ist ein Fehler aufgetreten. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Das Personenlebensereignis "{!EventNameText}" wurde erstellt.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
        <fullName>Create_Person_Life_Event_FSC_Package</fullName>
