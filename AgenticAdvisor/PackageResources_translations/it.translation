            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>Concierge incontri: pacchetto FSC Crea evento di vita della persona</label>
            <screens>
                <fields>
                    <fieldText>Nome evento</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Tipo di evento</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Data dell'evento</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Descrizione evento</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Si è verificato un errore durante la creazione del record Evento di vita della persona. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;L'evento di vita della persona {!EventNameText} è stato creato.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
