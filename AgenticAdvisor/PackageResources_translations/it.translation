            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Concierge incontri: pacchetto FSC Crea nuovi obiettivi o aggiorna obiettivi esistenti (periodico)</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Obiettivi esistenti aggiornati correttamente.&lt;/p&gt;&lt;p&gt;Le tue modifiche sono state salvate. &lt;/p&gt;&lt;p&gt;Adesso analizzeremo le tue note sull'incontro per suggerire nuovi obiettivi finanziari.&lt;/p&gt;&lt;p&gt;Fai clic su "Analizza note sull'incontro" per continuare. Questa operazione potrebbe richiedere fino a 30 secondi.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Si è verificato un errore durante l'esecuzione del flusso &lt;/p&gt;&lt;p&gt;Dettagli: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Tutti gli obiettivi sono stati esaminati e salvati correttamente.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Aggiorna obiettivo esistente&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Nome obiettivo</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Ammontare target</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Data target</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Stato</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Descrizione</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Nuovo obiettivo suggerito&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Nome obiettivo</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Tipo di obiettivo</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Stato obiettivo</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Ammontare target</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Data target</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Descrizione</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Salta questo obiettivo</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>Concierge incontri: pacchetto FSC Crea nuovi obiettivi o aggiorna obiettivi esistenti (periodico)</label>
