            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Meeting Concierge：定期建立新目標或更新現有目標 FSC 封裝</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ 已成功更新現有目標！&lt;/p&gt;&lt;p&gt;已儲存您的變更。&lt;/p&gt;&lt;p&gt;接下來，我們將分析您的會議記錄，並提出新的財務目標。&lt;/p&gt;&lt;p&gt;按一下「分析會議記錄」以繼續 — 這可能需要 30 秒。&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;執行流程時發生錯誤 &lt;/p&gt;&lt;p&gt;詳細資料：{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;已檢閱並成功儲存所有目標。&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;更新現有目標&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>目標名稱</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>目標金額</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>目標日期</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>狀態</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>描述</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;已建議心目標&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>目標名稱</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>目標類型</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>目標狀態</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>目標金額</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>目標日期</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>描述</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>跳過此目標</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>Meeting Concierge：定期建立新目標或更新現有目標 FSC 封裝</label>
