            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>เจ้าหน้าที่อำนวยความสะดวกการประชุม: แพ็กเกจสร้างเหตุการณ์ในชีวิตบุคคล FSC</label>
            <screens>
                <fields>
                    <fieldText>ชื่อเหตุการณ์</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>ประเภทเหตุการณ์</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>วันที่เหตุการณ์</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>คำอธิบายเหตุการณ์</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;เกิดข้อผิดพลาดบางอย่างในการสร้างเร็กคอร์ดเหตุการณ์ชีวิตบุคคล {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;เหตุการณ์ชีวิตบุคคล {!EventNameText} ถูกสร้างขึ้นแล้ว&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
