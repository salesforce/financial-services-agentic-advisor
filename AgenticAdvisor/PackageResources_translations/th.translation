            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>เจ้าหน้าที่อำนวยความสะดวกการประชุม: แพ็กเกจสร้างเป้าหมายใหม่เป็นระยะหรืออัปเดตเป้าหมายที่มีอยู่ FSC</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ อัปเดตเป้าหมายที่มีอยู่สำเร็จแล้ว!&lt;/p&gt;&lt;p&gt;การเปลี่ยนแปลงของคุณได้รับการบันทึกแล้ว&lt;/p&gt;&lt;p&gt;ถัดไป เราจะวิเคราะห์บันทึกการประชุมของคุณและแนะนำเป้าหมายทางการเงินใหม่&lt;/p&gt;&lt;p&gt;คลิก "วิเคราะห์บันทึกการประชุม" เพื่อดำเนินการต่อ — ขั้นตอนนี้อาจใช้เวลาสูงสุดถึง 30 วินาที&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;เกิดข้อผิดพลาดบางอย่างระหว่างการทำงานของโฟลว์&lt;/p&gt;&lt;p&gt;รายละเอียด: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;เป้าหมายทั้งหมดได้รับการตรวจสอบและบันทึกสำเร็จแล้ว&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;อัปเดตเป้าหมายที่มีอยู่&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>ชื่อเป้าหมาย</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>จำนวนเงินเป้าหมาย</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>วันที่เป้าหมาย</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>สถานะ</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>คำอธิบาย</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;เป้าหมายใหม่ที่เสนอ&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>ชื่อเป้าหมาย</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>ประเภทเป้าหมาย</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>สถานะเป้าหมาย</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>จำนวนเงินเป้าหมาย</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>วันที่เป้าหมาย</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>คำอธิบาย</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>ข้ามเป้าหมายนี้</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>เจ้าหน้าที่อำนวยความสะดวกการประชุม: แพ็กเกจสร้างเป้าหมายใหม่เป็นระยะหรืออัปเดตเป้าหมายที่มีอยู่ FSC</label>
    </flowDefinitions>
