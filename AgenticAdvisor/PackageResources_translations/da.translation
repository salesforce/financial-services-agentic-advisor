            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Meeting Concierge: Opret nye mål periodisk eller Opdater eksisterende mål - FSC-pakke</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Eksisterende mål blev opdateret!&lt;/p&gt;&lt;p&gt;Dine ændringer er blevet gemt. &lt;/p&gt;&lt;p&gt;Dernæst analyserer vi dine mødenotater for at foreslå nye finansielle mål.&lt;/p&gt;&lt;p&gt;Klik på "Analyser mødenotater" for at fortsætte – dette kan tage op til 30 sekunder.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Der gik noget galt under kørsel af forløbet &lt;/p&gt;&lt;p&gt;Detaljer: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Alle mål blev gennemgået og gemt.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Opdater eksisterende mål&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Målnavn</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Målbeløb</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Måldato</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Status</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Beskrivelse</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Nyt mål foreslået&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Målnavn</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Måltype</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Målstatus</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Målbeløb</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Måldato</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Beskrivelse</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Ignorer dette mål</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
