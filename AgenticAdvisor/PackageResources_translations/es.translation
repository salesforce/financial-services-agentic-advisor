            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Meeting Concierge: Paquete FSC Creación periódica de nuevos objetivos o actualización de los existentes</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Objetivos existentes actualizados correctamente.&lt;/p&gt;&lt;p&gt;Sus cambios se han guardado. &lt;/p&gt;&lt;p&gt;A continuación, analizaremos sus notas de la reunión para sugerirle nuevos objetivos financieros. &lt;/p&gt;&lt;p&gt;Haga clic en "Analizar notas de la reunión" para continuar; esto puede tardar hasta 30 segundos.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Se ha producido un error al ejecutar el flujo &lt;/p&gt;&lt;p&gt;Detalles: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Se han revisado y guardado correctamente todos los objetivos.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Actualizar objetivo existente&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Nombre del objetivo</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Importe del objetivo</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Fecha objetivo</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Estado</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Descripción</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Se sugiere un nuevo objetivo&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Nombre del objetivo</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Tipo de objetivo</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Estado del objetivo</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Importe del objetivo</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Fecha objetivo</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Descripción</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Omitir este objetivo</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>Meeting Concierge: Paquete FSC Creación periódica de nuevos objetivos o actualización de los existentes</label>
    </flowDefinitions>
