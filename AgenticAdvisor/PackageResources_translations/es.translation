            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>Meeting Concierge: Paquete FSC Crear evento de vida de una persona</label>
            <screens>
                <fields>
                    <fieldText>Nombre del evento de vida</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Tipo de evento</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Fecha del evento</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Descripción del evento de vida</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Se ha producido un error al crear el registro del evento de vida de una persona. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Se ha creado el evento de vida {!EventNameText} de una persona.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
        <fullName>Create_Person_Life_Event_FSC_Package</fullName>
