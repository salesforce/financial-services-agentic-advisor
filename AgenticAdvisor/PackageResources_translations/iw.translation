            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>המסייע לפגישות: יצירה תקופתית של יעדים חדשים או עדכון קיימים - חבילת FSC</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ היעדים הקיימים עודכנו בהצלחה!&lt;/p&gt;&lt;p&gt;השינויים נשמרו. &lt;/p&gt;&lt;p&gt;בשלב הבא, ננתח את הערות לפגישה שלך כדי להציע יעדים פיננסיים חדשים.&lt;/p&gt;&lt;p&gt;לחץ על "ניתוח הערות לפגישה" כדי להמשיך – פעולה זו עשויה להמשך עד 30 שניות.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;משהו השתבש במהלך הפעלת הזרימה &lt;/p&gt;&lt;p&gt;פרטים: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;כל היעדים נבדקו ונשמרו בהצלחה.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;עדכון יעד קיים&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>שם יעד</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>סכום יעד</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>תאריך יעד</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>מצב</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>תיאור</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;הוצע יעד חדש&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>שם יעד</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>סוג יעד</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>סטטוס יעד</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>סכום יעד</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>תאריך יעד</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>תיאור</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>דלג על יעד זה</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>המסייע לפגישות: יצירה תקופתית של יעדים חדשים או עדכון קיימים - חבילת FSC</label>
