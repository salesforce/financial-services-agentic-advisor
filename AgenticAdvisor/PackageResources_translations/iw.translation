                </fields>
                <fields>
                    <fieldText>תאריך אירוע</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>תיאור אירוע</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;משהו השתבש בעת יצירת רשומת אירוע בחיים. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;אירוע בחיים {!EventNameText} נוצר.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
