            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>ミーティングコンシェルジュ: [Periodic Create New Goals Or Update Existing Goals (新規ゴールを定期的に作成または既存のゴールを更新)] FSC パッケージ</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ 既存のゴールが正常に更新されました。&lt;/p&gt;&lt;p&gt;変更が保存されました。&lt;/p&gt;&lt;p&gt;次に、ミーティングメモが分析されて、新しい投資運用ゴールが推奨されます。&lt;/p&gt;&lt;p&gt;続行するには、[Analyze Meeting Notes (ミーティングメモを分析)] をクリックしてください — この処理には、最大 30 秒かかる場合があります。&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;フローの実行中に問題が発生しました&lt;/p&gt;&lt;p&gt;詳細: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;すべてのゴールが確認され、正常に保存されました。&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;既存のゴールを更新&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>ゴール名</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>目標金額</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>目標日</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>状況</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>説明</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;新しいゴールが推奨されました&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>ゴール名</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>ゴール種別</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>ゴール状況</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>目標金額</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>ターゲット日</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>説明</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>このゴールをスキップ</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>ミーティングコンシェルジュ: [Periodic Create New Goals Or Update Existing Goals (新規ゴールを定期的に作成または既存のゴールを更新)] FSC パッケージ</label>
    </flowDefinitions>
