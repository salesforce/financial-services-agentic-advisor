            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>ミーティングコンシェルジュ: [Create Person Life Event (個人ライフイベントを作成)] FSC パッケージ</label>
            <screens>
                <fields>
                    <fieldText>イベント名</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>イベントタイプ</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>イベント日</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>イベントの説明</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;個人ライフイベントレコードの作成中に問題が発生しました。{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;個人ライフイベント {!EventNameText} が作成されました。&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
        <fullName>Create_Person_Life_Event_FSC_Package</fullName>
        <label>ミーティングコンシェルジュ: [Create Person Life Event (個人ライフイベントを作成)] FSC パッケージ</label>
    </flowDefinitions>
