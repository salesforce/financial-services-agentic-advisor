            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Meeting Concierge: Luo uusia tavoitteita säännöllisesti tai päivitä nykyiset tavoitteet (FSC-paketti)</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Nykyiset tavoitteet päivitettiin onnistuneesti!&lt;/p&gt;&lt;p&gt;Muutoksesi tallennettiin. &lt;/p&gt;&lt;p&gt;Seuraavaksi analysoimme kokouksesi muistiinpanot ja ehdotamme uusia liiketoimintatavoitteita.&lt;/p&gt;&lt;p&gt;Napsauta ”Analysoi kokouksen muistiinpanot” jatkaaksesi — tämä voi kestää 30 sekuntia.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Jokin meni vikaan kulkua suoritettaessa &lt;/p&gt;&lt;p&gt;Lisätiedot: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Kaikki tavoitteet on tarkistettu ja tallennettu onnistuneesti.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Päivitä nykyinen tavoite&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Tavoitteen nimi</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Tavoitesumma</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Tavoitepäivämäärä</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Tila</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Kuvaus</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Uusi ehdotettu tavoite&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Tavoitteen nimi</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Tavoitteen tyyppi</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Tavoitteen tila</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Tavoitesumma</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Tavoitepäivämäärä</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Kuvaus</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Ohita tämä tavoite</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
