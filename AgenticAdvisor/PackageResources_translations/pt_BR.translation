            <fullName>Create_Person_Life_Event_FSC_Package</fullName>
            <label>Concierge de reuniões: Criar evento de vida pessoal – Pacote FSC</label>
            <screens>
                <fields>
                    <fieldText>Nome do evento</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Tipo de evento</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Data do evento</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Descrição do evento</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Ocorreu um erro ao criar o registro do Evento de vida pessoal. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;O Evento de vida pessoal {!EventNameText} foi criado.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
        <fullName>Create_Person_Life_Event_FSC_Package</fullName>
