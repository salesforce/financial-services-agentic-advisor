            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Concierge de reuniões: Criar periodicamente novas metas ou atualizar metas existentes – Pacote FSC</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Metas existentes atualizadas com sucesso!&lt;/p&gt;&lt;p&gt;Suas alterações foram salvas. &lt;/p&gt;&lt;p&gt;A seguir, analisaremos suas anotações da reunião para sugerir novas metas financeiras.&lt;/p&gt;&lt;p&gt;Clique em "Analisar anotações da reunião" para continuar — isso pode levar até 30 segundos.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Ocorreu um erro durante a execução do fluxo &lt;/p&gt;&lt;p&gt;Detalhes: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Todas as metas foram revisadas e salvas com sucesso.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Atualizar meta existente&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Nome da meta</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Valor previsto</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Data prevista</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Status</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Descrição</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Nova meta sugerida&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Nome da meta</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Tipo de meta</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Status da meta</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Valor previsto</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Data prevista</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Descrição</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Ignorar esta meta</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>Concierge de reuniões: Criar periodicamente novas metas ou atualizar metas existentes – Pacote FSC</label>
    </flowDefinitions>
