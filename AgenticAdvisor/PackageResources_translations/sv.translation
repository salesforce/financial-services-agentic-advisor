            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Möteskoordinator: FSC-paket för att regelbundet skapa nya mål eller uppdatera befintliga mål</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Befintliga mål har uppdaterats!&lt;/p&gt;&lt;p&gt;Dina ändringar har sparats. &lt;/p&gt;&lt;p&gt;Därefter kommer vi att analysera dina mötesanteckningar och föreslå nya ekonomiska mål.&lt;/p&gt;&lt;p&gt;Klicka på "Analysera mötesanteckningar" för att fortsätta – detta kan ta upp till 30 sekunder.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Något gick fel när flödet kördes &lt;/p&gt;&lt;p&gt;Detaljer: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Alla mål har granskats och sparats.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Uppdatera befintligt mål&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Målnamn</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Målbelopp</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Måldatum</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Status</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Beskrivning</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Nytt mål föreslaget&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Målnamn</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Måltyp</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Målstatus</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Målbelopp</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Måldatum</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Beskrivning</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Hoppa över detta mål</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
        <label>Möteskoordinator: FSC-paket för att regelbundet skapa nya mål eller uppdatera befintliga mål</label>
