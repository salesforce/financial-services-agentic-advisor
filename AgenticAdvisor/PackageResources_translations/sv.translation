                    <fieldText>Händelsenamn</fieldText>
                    <name>EventNameText</name>
                </fields>
                <fields>
                    <fieldText>Händelsetyp</fieldText>
                    <name>EventTypePicklist</name>
                </fields>
                <fields>
                    <fieldText>Händelsedatum</fieldText>
                    <name>EventDateText</name>
                </fields>
                <fields>
                    <fieldText>Händelsebeskrivning</fieldText>
                    <name>EventDescLongTextArea</name>
                </fields>
                <name>ScreenCreaPersonLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Något gick fel vid skapande av post för persons livshändelse. {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>CreaPersnLifeEvntErrorDisplayText</name>
                </fields>
                <name>ScreenDisplayErrorCreaPersnLifeEvnt</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Personens livshändelse {!EventNameText} skapades.&lt;/p&gt;</fieldText>
                    <name>CreaSuccessDisplayText</name>
                </fields>
                <name>ScreenLifeEvntSaved</name>
            </screens>
        </flows>
