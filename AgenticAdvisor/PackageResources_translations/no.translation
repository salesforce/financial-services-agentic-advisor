            <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
            <label>Møteconcierge: Opprett periodisk nye mål eller oppdater eksisterende mål – FSC-pakke</label>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;✅ Eksisterende mål er oppdatert!&lt;/p&gt;&lt;p&gt;Endringene er lagret. &lt;/p&gt;&lt;p&gt;Det neste vi skal gjøre, er å analysere møtenotatene og foreslå nye økonomiske mål.&lt;/p&gt;&lt;p&gt;Klikk på "Analyser møtenotater" for å fortsette. Dette kan ta opptil 30 sekunder.&lt;/p&gt;</fieldText>
                    <name>UpdatedExistingGoals</name>
                </fields>
                <name>DisplayMessage</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Noe gikk galt ved kjøring av flyten &lt;/p&gt;&lt;p&gt;Detaljer: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
                    <name>ErrorMessage</name>
                </fields>
                <name>Error_Screen</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;p&gt;Alle mål er gjennomgått og lagret.&lt;/p&gt;</fieldText>
                    <name>SavedGoalScreen</name>
                </fields>
                <name>Goals_Saved</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Oppdater eksisterende mål&lt;/h5&gt;</fieldText>
                    <name>GoalDetails</name>
                </fields>
                <fields>
                    <fieldText>Navn på mål</fieldText>
                    <name>Goal_Name</name>
                </fields>
                <fields>
                    <fieldText>Målbeløp</fieldText>
                    <name>Target_Amount</name>
                </fields>
                <fields>
                    <fieldText>Måldato</fieldText>
                    <name>Target_Date</name>
                </fields>
                <fields>
                    <fieldText>Status</fieldText>
                    <name>Status</name>
                </fields>
                <fields>
                    <fieldText>Beskrivelse</fieldText>
                    <name>Description</name>
                </fields>
                <name>Review_Existing_Goal</name>
            </screens>
            <screens>
                <fields>
                    <fieldText>&lt;h5&gt;Nytt mål foreslått&lt;/h5&gt;</fieldText>
                    <name>CreatingNewGoal</name>
                </fields>
                <fields>
                    <fieldText>Navn på mål</fieldText>
                    <name>scr_GoalName</name>
                </fields>
                <fields>
                    <fieldText>Måltype</fieldText>
                    <name>scr_GoalType</name>
                </fields>
                <fields>
                    <fieldText>Målstatus</fieldText>
                    <name>scr_GoalStatus</name>
                </fields>
                <fields>
                    <fieldText>Målbeløp</fieldText>
                    <name>scr_GoalAmount</name>
                </fields>
                <fields>
                    <fieldText>Måldato</fieldText>
                    <name>scr_GoalTargetDate</name>
                </fields>
                <fields>
                    <fieldText>Beskrivelse</fieldText>
                    <name>scr_GoalDescription</name>
                </fields>
                <fields>
                    <fieldText>Hopp over dette målet</fieldText>
                    <name>scr_SkipGoal</name>
                </fields>
                <name>Review_New_Goal</name>
            </screens>
        </flows>
        <fullName>Periodic_Create_New_Goals_Or_Update_Existing_Goals_FSC_Package</fullName>
